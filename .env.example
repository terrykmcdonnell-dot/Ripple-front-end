# Copy to `.env` for local development (never commit real secrets).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# @react-native-google-signin/google-signin — see GOOGLE_OAUTH_SETUP.md.
# WEB OAuth client → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (required for ID token / Supabase).
# iOS OAuth client → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (recommended; bundle must match app.json).
# Android OAuth client IDs align Google Console SHA/package — env optional for JS; keep for docs.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# RevenueCat — public SDK key from Project → API keys (Test Store / Apple / Google).
# Optional per-platform overrides if your dashboard uses separate keys:
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Entitlement identifier configured in RevenueCat (must match dashboard).
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Settings → About (open with Linking.openURL)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=
# HTTPS form or mailto:user@domain.com
EXPO_PUBLIC_FEEDBACK_URL=
# Numeric App Store app id for iOS review sheet (e.g. 1234567890)
EXPO_PUBLIC_APP_STORE_ID=
