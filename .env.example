# Copy to `.env` for local development (never commit real secrets).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# @react-native-google-signin/google-signin — see GOOGLE_OAUTH_SETUP.md.
# WEB OAuth client → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (required for ID token / Supabase).
# iOS OAuth client → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (recommended; bundle must match app.json).
# Android OAuth client IDs align Google Console SHA/package — env optional for JS; keep for docs.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
