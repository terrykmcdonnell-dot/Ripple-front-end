# Copy to `.env` for local development (never commit real secrets).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# @react-native-google-signin/google-signin — see GOOGLE_OAUTH_SETUP.md.
# WEB OAuth client → EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (required for ID token / Supabase).
# iOS OAuth client → EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID (recommended; bundle must match app.json).
# Android OAuth client IDs align Google Console SHA/package — env optional for JS; keep for docs.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Physical device / Expo Go cannot reach your PC's "localhost" — use LAN IP, e.g. http://192.168.1.10:8000
# Android emulator → host machine: http://10.0.2.2:8000
# Production: https://your-api.example.com

# RevenueCat — public SDK keys from Project → API keys (per store).
# iOS / Apple App Store
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# Android / Google Play
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# Optional single key for dev or one-store testing (used when platform-specific key is empty)
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Entitlement identifier configured in RevenueCat (must match dashboard).
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Settings → About → Rate Ripple (iOS App Store review link)
EXPO_PUBLIC_APP_STORE_ID=
# Settings → About → Ripple website (marketing / dashboard)
EXPO_PUBLIC_RIPPLE_MARKETING_WEBSITE_URL=https://ripplealarm.com/
