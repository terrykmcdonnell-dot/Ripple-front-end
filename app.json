{
  "expo": {
    "name": "Ripple-Alarm",
    "slug": "repple-alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alarm-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      }
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.terrykm.ripplealarm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.terrykm.ripplealarm"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "alarm-app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a1423",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.terrykm.ripplealarm",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-android-notification-policy-permission",
      "./plugins/with-android-alarm-activity",
      "./plugins/with-android-alarm-full-screen-intent",
      "./plugins/with-android-alarm-sound-service",
      "./plugins/with-android-alarm-wake-activity",
      "./plugins/with-android-alarm-native-lockscreen",
      "./plugins/with-ios-google-modular-headers",
      "expo-apple-authentication",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a1423",
          "dark": {
            "backgroundColor": "#0a1423"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.219598516590-d4vhe3j1lft5e28i3m045fm52sjig15p"
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true,
          "sounds": [
            "./assets/sounds/gentle_rise.wav",
            "./assets/sounds/morning_glow.wav",
            "./assets/sounds/classic_bell.wav",
            "./assets/sounds/digital_beep.wav",
            "./assets/sounds/soft_piano.wav",
            "./assets/sounds/nature_birds.wav"
          ]
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7073624f-7686-47a1-b177-cac58f1b04d6"
      }
    },
    "owner": "terrykm",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/7073624f-7686-47a1-b177-cac58f1b04d6",
      "enabled": false
    }
  }
}
